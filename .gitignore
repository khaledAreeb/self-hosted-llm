# Python virtual environments
venv/
.venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Secrets and credentials -- Modal proxy auth tokens, HF tokens, LiteLLM keys
.env
.env.*
!.env.example
*.key
*.pem
secrets.yaml
secrets.yml

# Modal local state
.modal/
.modal.toml

# Model weights -- these live in Modal Volumes and on Hugging Face, never in git
*.safetensors
*.gguf
*.bin
models/

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Real company documents and images used by eval/run_eval.py -- kept
# local on purpose; data residency is why this deployment exists.
eval/docs/
eval/images/

# Load-test tooling (GuideLLM + CPU torch) lives in its own environment.
bench/.venv/

# eval/run_eval.py copies deploy.py next to its results. For runs served by a
# Shadeform VM that copy is NOT the serving configuration, so it stays local
# (see the README.md in each of these folders).
eval/results/2026-10-01/deploy.py
eval/results/2026-10-04/deploy.py

# Personal, unrelated work-in-progress notes.
deploy_on_azure
