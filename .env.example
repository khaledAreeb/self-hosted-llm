# Copy to .env (git-ignored) and fill in only what you use:  cp .env.example .env

# Modal: the proxy token callers send as "Authorization: Bearer ...".
# Create one with:  ./venv/bin/modal workspace proxy-tokens create <name>
# Format: wk-<id>.ws-<secret>   (the secret is shown only once)
MODAL_PROXY_TOKEN=

# Shadeform: a dedicated API key (Settings -> API keys), not the Default key.
SHADEFORM_API_KEY=

# The key vLLM requires on Shadeform VMs. Leave this commented out and the
# first `shadeform_deploy.py up` generates one and saves it here (never printed).
# To choose your own: 16+ characters, no spaces.
# VLLM_API_KEY=
